window-rule {
    geometry-corner-radius 6 // Set every window radius to 2
    clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="top-right"
    open-focused false
}


layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// VRR
window-rule {
    match app-id="^steam_app_.*$"
    variable-refresh-rate true
}

// Picture in picture
window-rule {
    match app-id=r#"^org.mozilla.firefox$"# title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=16 y=48 relative-to="bottom-right"
}
